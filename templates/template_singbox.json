{
  "log": {
    "level": "info",
    "timestamp": true
  },

  "dns": {
    "servers": [
      { "tag": "local", "type": "udp", "server": "223.5.5.5" },
      { "tag": "public", "type": "https", "server": "dns.alidns.com" },
      { "tag": "foreign", "type": "https", "server": "8.8.8.8" }
    ],
    "rules": [
      {
        "rule_set": ["geosite-cn", "geosite-steamcn", "geosite-apple"],
        "server": "local"
      },
      {
        "domain_suffix": ["services.googleapis.cn", "googleapis.cn"],
        "server": "foreign"
      }
    ],
    "final": "foreign",
    "strategy": "prefer_ipv4",
    "independent_cache": true,
    "reverse_mapping": true
  },

  "inbounds": [
    {
      "tag": "dns-in",
      "type": "direct",
      "listen": "0.0.0.0",
      "listen_port": 1053
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7890
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "interface_name": "tun0",
      "address": ["172.19.0.1/30", "fd00::1/126"],
      "stack": "mixed",
      "auto_route": true,
      "auto_redirect": true,
      "mtu": 1400
    }
  ],

  "outbounds": [
    {{ outbounds }},

    { "tag": "proxy", "type": "selector", "outbounds": ["auto", "hk", "jp", "sg", "us", "manual"] },
    { "tag": "ai", "type": "selector", "outbounds": ["jp", "sg", "us"] },
    { "tag": "youtube", "type": "selector", "outbounds": ["hk", "jp", "sg", "us"] },
    { "tag": "google", "type": "selector", "outbounds": ["hk", "jp", "sg", "us"] },
    { "tag": "github", "type": "selector", "outbounds": ["jp", "hk", "sg", "us"] },
    { "tag": "telegram", "type": "selector", "outbounds": ["sg", "hk", "jp", "us"] },
    { "tag": "tiktok", "type": "selector", "outbounds": ["jp", "sg", "us"] },
    { "tag": "netflix", "type": "selector", "outbounds": ["hk", "jp", "sg", "us"] },
    { "tag": "paypal", "type": "selector", "outbounds": ["hk", "jp", "us"] },
    { "tag": "steam", "type": "selector", "outbounds": ["hk", "jp"] },
    { "tag": "microsoft", "type": "selector", "outbounds": ["proxy", "direct"] },
    { "tag": "onedrive", "type": "selector", "outbounds": ["proxy", "direct"] },
    { "tag": "apple", "type": "selector", "outbounds": ["direct", "proxy"] },
    { "tag": "fallback", "type": "selector", "outbounds": ["proxy", "direct"] },

    { "tag": "hk", "type": "selector", "outbounds": [] },
    { "tag": "jp", "type": "selector", "outbounds": [] },
    { "tag": "sg", "type": "selector", "outbounds": [] },
    { "tag": "us", "type": "selector", "outbounds": [] },

    { "tag": "manual", "type": "selector", "outbounds": [] },

    {
      "tag": "auto",
      "type": "urltest",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },

    { "tag": "direct", "type": "direct" }
  ],

  "route": {
    "rules": [
      { "inbound": "dns-in", "action": "hijack-dns" },

      { "rule_set": "geosite-ai", "outbound": "ai" },
      { "rule_set": "geosite-youtube", "outbound": "youtube" },
      { "rule_set": "geosite-google", "outbound": "google" },
      { "rule_set": "geosite-github", "outbound": "github" },
      { "rule_set": "geosite-onedrive", "outbound": "onedrive" },
      { "rule_set": "geosite-microsoft", "outbound": "microsoft" },
      { "rule_set": "geosite-apple", "outbound": "apple" },
      { "rule_set": "geosite-telegram", "outbound": "telegram" },
      { "rule_set": "geosite-tiktok", "outbound": "tiktok" },
      { "rule_set": "geosite-netflix", "outbound": "netflix" },
      { "rule_set": "geosite-paypal", "outbound": "paypal" },
      { "rule_set": "geosite-steam", "outbound": "steam" },

      { "rule_set": ["geosite-steamcn", "geosite-cn"], "outbound": "direct" },
      { "rule_set": "geosite-!cn", "outbound": "proxy" },

      { "rule_set": "geoip-cn", "outbound": "direct" },
      { "ip_is_private": true, "outbound": "direct" }
    ],

    "rule_set": [
      { "tag": "geosite-ai", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ai-!cn.srs" },
      { "tag": "geosite-youtube", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/youtube.srs" },
      { "tag": "geosite-google", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/google.srs" },
      { "tag": "geosite-github", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/github.srs" },
      { "tag": "geosite-onedrive", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/onedrive.srs" },
      { "tag": "geosite-microsoft", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/microsoft.srs" },
      { "tag": "geosite-apple", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple.srs" },
      { "tag": "geosite-telegram", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/telegram.srs" },
      { "tag": "geosite-tiktok", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/tiktok.srs" },
      { "tag": "geosite-netflix", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/netflix.srs" },
      { "tag": "geosite-paypal", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/paypal.srs" },
      { "tag": "geosite-steamcn", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/steam@cn.srs" },
      { "tag": "geosite-steam", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/steam.srs" },
      { "tag": "geosite-!cn", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs" },
      { "tag": "geosite-cn", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs" },
      { "tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://github.com/qljsyph/ruleset-icon/raw/refs/heads/main/sing-box/geoip/China-ASN-combined-ip.srs" }
    ],

    "final": "fallback",
    "default_domain_resolver": { "server": "public" }
  },

  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "./cache.db",
      "store_fakeip": false
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "./ui",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip",
      "default_mode": "rule"
    }
  }
}
