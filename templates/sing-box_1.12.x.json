{
  "log": {
    "disabled": false,
    "level": "error",
    "output": "/var/log/sing-box.log",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "/opt/sing-box/ui",
      "secret": "",
      "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
      "external_ui_download_detour": "Proxy",
      "default_mode": "rule"
    },
    "cache_file": {
      "enabled": true,
      "path": "/opt/sing-box/cache.db",
      "store_fakeip": false,
      "store_rdrc": true
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "Proxy"
      },
      {
        "tag": "dns_ali",
        "type": "https",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "clash_mode": "全局直连",
        "server": "dns_ali"
      },
      {
        "clash_mode": "全局代理",
        "server": "dns_google"
      },
      {
        "rule_set": "geosite-cn",
        "server": "dns_ali"
      }
    ],
    "strategy": "ipv4_only",
    "independent_cache": true
  },
  "inbounds": [
    {
      "tag": "tproxy-in",
      "type": "tproxy",
      "listen": "0.0.0.0",
      "listen_port": 7891
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7890
    }
  ],
  "outbounds": [
